# GEMINI_API_KEY: Required only if future AI features are enabled server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"

# Optional Consultation Persistence Webhook (e.g., CRM, database ingest, or automation webhook)
# Leave unset to keep the Contact form in transparent demonstration validation mode.
INQUIRY_WEBHOOK_URL=""

# Optional SMTP Email Notification Settings
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
INQUIRY_RECIPIENT_EMAIL=""
